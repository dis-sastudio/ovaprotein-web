# Copia a .env (local) o configúralas en Netlify > Site configuration > Environment variables
SITE_URL=https://www.ovaprotein.com

# PayPhone Developer (https://appdeveloper.payphonetodoesposible.com)
PAYPHONE_TOKEN=
PAYPHONE_STORE_ID=

# Aviso por correo de pedidos pagados (opcional, https://resend.com)
RESEND_API_KEY=
ORDER_EMAIL_TO=pedidos@ovaprotein.com
ORDER_EMAIL_FROM=OVA PRO+ <pedidos@ovaprotein.com>

# WhatsApp Cloud API (Meta for Developers)
WA_VERIFY_TOKEN=elige-una-frase-secreta
WA_ACCESS_TOKEN=
WA_PHONE_NUMBER_ID=
WA_APP_SECRET=
WA_API_VERSION=v25.0

# Modo IA del bot (opcional): responde preguntas libres con la base de conocimiento
ANTHROPIC_API_KEY=
ANTHROPIC_MODEL=claude-haiku-5-5
CANONICAL_HOST=www.ovaprotein.com

# --- Pedidos y panel /admin ---
# Contraseña del panel ovaprotein.com/admin (mínimo 8 caracteres; usa una larga)
ADMIN_PASSWORD=
# Datos bancarios que ve el cliente al pedir por transferencia (separa líneas con |)
BANK_INFO=Banco ...|Cuenta de ahorros 0000000000|Titular: ...|RUC/C.I. ...
# Correo saliente (Hostinger)
SMTP_HOST=smtp.hostinger.com
SMTP_PORT=465
SMTP_USER=hola@ovaprotein.com
SMTP_PASS=
MAIL_FROM=OVA PRO+ <hola@ovaprotein.com>
# A dónde llega el aviso de cada pedido nuevo
ORDER_EMAIL_TO=hola@ovaprotein.com
